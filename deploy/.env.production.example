# Production — copy to deploy/.env.production (git'ga commit qilmang)

DJANGO_SECRET_KEY=
POSTGRES_DB=imentor
POSTGRES_USER=imentor
POSTGRES_PASSWORD=

# Server IP ni qo'shing: masalan 87.192.230.208
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,imentor.devflix.uz,87.192.230.208
DJANGO_CORS_ALLOWED_ORIGINS=https://imentor.devflix.uz,http://imentor.devflix.uz,https://fermi.uz,https://www.fermi.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://imentor.devflix.uz,http://imentor.devflix.uz

VITE_API_BASE_URL=/api
OPENAI_API_KEY=

# Tashqi servislar (test bazasi API) — X-Api-Key header
# IMENTOR_EXTERNAL_API_KEYS=partner-secret-key

# OnlineTest — talaba auth (bitta login manbai)
# ONLINE_TEST_API_BASE_URL=https://onlinetest.example.com

ADMIN_PHONE=998907863888
ADMIN_PASSWORD=

# Ochiq ro'yxatdan o'tish yopiq — xodimlarni faqat admin qo'shadi.
DJANGO_ALLOW_OPEN_REGISTRATION=False
DJANGO_BEHIND_PROXY=True

# Login sahifasida demo tugmalari
VITE_ENABLE_DEMO_AUTH=true

# http://IP:9050 — shu yetarli (SSL yoqilgach True qiling)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

IMENTOR_HTTP_BIND=127.0.0.1
IMENTOR_HTTP_PORT=9050
