# Production — copy to deploy/.env.production on the server (never commit .env.production).

# Kamida 40 tasodifiy belgi (misol — productionda yangi qiymat yarating):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
# Tarqatma rasmlari /media/ orqali (docker volume + nginx proxy)
DJANGO_SERVE_MEDIA=True
DJANGO_ALLOWED_HOSTS=api.imentor.uz,imentor.uz,www.imentor.uz,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://imentor.uz,https://www.imentor.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://imentor.uz,https://www.imentor.uz,https://api.imentor.uz

# /api — imentor.uz bilan bir domen (CORS yo'q). Eski: https://api.imentor.uz/api
VITE_API_BASE_URL=/api

# DeepSeek (deepseek-chat / deepseek-reasoner) — test, keys, ma'ruza, tarjima (taqdimot emas).
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Django admin — telefon orqali kirish (username = 12 raqam, masalan 998907863888)
ADMIN_PHONE=998907863888
ADMIN_PASSWORD=
DEMO_ADMIN_PHONES=998907863888

IMENTOR_BACKEND_PORT=31002
IMENTOR_FRONTEND_PORT=31001
