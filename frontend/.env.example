# Google Gemini — mahalliy dev. Server: deploy/.env.production + docker compose --build
# Kalit frontend build vaqtida static bundle ichiga yoziladi (Vite define).
# 403 bo'lsa: AI Studio → API kalit → "Generative Language API" yoqilganmi, HTTP referrer chekloviga https://imentor.uz qo'shilganmi.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend base URL (Django REST API)
VITE_API_BASE_URL="http://localhost:8000/api"
